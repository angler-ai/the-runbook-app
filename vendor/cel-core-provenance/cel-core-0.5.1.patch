+    }
+    for source in ["xs.all(x, true)", "xs.exists(i, x, true)", "has(x.a)"] {
+        assert!(matches!(
+            parse_bounded(source, &limits).unwrap().ast.unwrap().node,
+            cel_core::Expr::Call { .. }
+        ));
+    }
