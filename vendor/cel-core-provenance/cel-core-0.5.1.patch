+pub(super) fn parse_tokens_bounded(
+    tokens: &[SpannedToken],
+) -> Result<super::ParseResult, CompileLimitError> {
+    let mut parser = Parser::with_macros(tokens, MacroRegistry::new());
+    parser.budget = Some(Box::new(Budget {
+        frames: Rc::new(Cell::new(0)),
+        nodes: 0,
+        work: 0,
+        macro_count: 0,
+        heights: [0; 513],
+        sizes: [0; 513],
+        error: None,
+    }));
+    let parsed = parser.parse_expr();
+    if let Some(error) = parser.budget.as_mut().and_then(|b| b.error.take()) {
+        return Err(error);
+    }
+    let mut errors = parser.take_macro_errors();
+    let ast = match parsed {
+        Ok(ast) => {
+            if !parser.at_end() {
+                errors.push(ParseError {
+                    message: "unexpected tokens after expression".into(),
+                    span: parser.peek_span(),
+                });
+            }
+            Some(*ast)
+        }
+        Err(error) => {
+            errors.push(*error);
+            None
+        }
+    };
+    if errors.len() > CompileLimits::DIAGNOSTICS
+        || errors.iter().map(|e| e.message.len()).sum::<usize>() > CompileLimits::DIAGNOSTIC_BYTES
+    {
+        return Err(CompileLimitError {
+            kind: CompileLimitKind::Diagnostics,
+            span: parser.peek_span(),
+        });
+    }
+    Ok(super::ParseResult {
+        ast,
+        macro_calls: MacroCalls::new(),
+        errors: errors
+            .into_iter()
+            .map(|e| super::ParseError {
+                message: e.message,
+                span: e.span,
+            })
+            .collect(),
+    })
 }
 
