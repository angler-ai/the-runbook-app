+#[test]
+fn equality_consumes_operand_identity_and_stops_after_failed_hook() {
+    struct Consumption {
+        ids: RefCell<Vec<i64>>,
+        stop: bool,
+    }
+    impl EvalObserver for Consumption {
+        fn consume_value(&self, scope: u64, expr_id: i64, _: &Value) -> Result<(), ObserverStop> {
