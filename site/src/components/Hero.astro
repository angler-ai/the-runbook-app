---
// Overrides Starlight's Hero for the landing page: the frontmatter's title,
// tagline and actions on the left, and on the right a run as the web app
// shows it, its steps drawn as the logo's bars (done in indigo, the current
// one in mint).
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="rb-hero">
  <div class="rb-hero-copy">
    <p class="rb-eyebrow">Open source · self-hosted · AGPL-3.0</p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="rb-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="rb-actions">
          {actions.map(({ icon, link: href, text, variant, attrs }) => (
            <LinkButton href={href} variant={variant} icon={icon?.name} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>

  <figure class="rb-run" aria-label="An example run: two agent checks passed, an approval is waiting on the on-call team">
    <div class="rb-run-head">
      <div>
        <div class="rb-run-title">Verify api after v2.4.0</div>
        <div class="rb-run-sub">post-deploy-checks · started by a webhook</div>
      </div>
      <span class="rb-pill rb-pill-waiting">Waiting</span>
    </div>
    <ol class="rb-steps">
      <li class="rb-step rb-done">
        <span class="rb-bar" aria-hidden="true"></span>
        <div class="rb-step-body">
          <div class="rb-step-title">Check health</div>
          <div class="rb-step-meta"><span class="rb-actor">agent</span> 3 × 200 in 140 ms</div>
        </div>
        <span class="rb-verdict">pass</span>
      </li>
      <li class="rb-step rb-done">
        <span class="rb-bar" aria-hidden="true"></span>
        <div class="rb-step-body">
          <div class="rb-step-title">Compare error rate</div>
          <div class="rb-step-meta"><span class="rb-actor">agent</span> 0.2% vs 0.3% before</div>
        </div>
        <span class="rb-verdict">pass</span>
      </li>
      <li class="rb-step rb-current">
        <span class="rb-bar" aria-hidden="true"></span>
        <div class="rb-step-body">
          <div class="rb-step-title">Keep the deploy?</div>
          <div class="rb-step-meta"><span class="rb-actor rb-actor-human">approval</span> team:oncall</div>
          <div class="rb-options" aria-hidden="true">
            <span class="rb-option rb-option-primary">keep</span>
            <span class="rb-option">rollback</span>
          </div>
        </div>
      </li>
      <li class="rb-step rb-todo">
        <span class="rb-bar" aria-hidden="true"></span>
        <div class="rb-step-body">
          <div class="rb-step-title">Roll back</div>
          <div class="rb-step-meta"><span class="rb-actor">agent</span> destructive · if rollback</div>
        </div>
      </li>
    </ol>
  </figure>
</div>

<style>
  .rb-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 3vw, 2.5rem);
  }
  .rb-eyebrow {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rb-mint-text);
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
  }
  .rb-tagline {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    margin: 1.25rem 0 0;
    max-width: 34rem;
  }
  .rb-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }

  .rb-run {
    margin: 0;
    background: var(--rb-card);
    border: 1px solid var(--rb-line);
    border-radius: 14px;
    box-shadow: var(--rb-shadow);
    padding: 1.1rem 1.1rem 0.6rem;
    font-size: var(--sl-text-sm);
  }
  .rb-run-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.1rem 0.25rem 0.9rem;
    border-bottom: 1px solid var(--rb-line);
  }
  .rb-run-title {
    font-weight: 600;
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
  }
  .rb-run-sub {
    color: var(--rb-muted);
    font-size: var(--sl-text-xs);
    margin-top: 0.15rem;
  }
  .rb-pill {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }
  .rb-pill-waiting {
    color: var(--rb-indigo);
    background: var(--rb-indigo-subtle);
  }
  .rb-steps {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0 0;
  }
  .rb-step {
    display: grid;
    grid-template-columns: 0.4rem 1fr auto;
    gap: 0.85rem;
    align-items: start;
    padding: 0.7rem 0.25rem;
    margin: 0;
  }
  .rb-step + .rb-step {
    border-top: 1px dashed var(--rb-line);
  }
  .rb-bar {
    align-self: stretch;
    border-radius: 999px;
    background: var(--rb-line);
    min-height: 2.2rem;
  }
  .rb-done .rb-bar {
    background: var(--rb-indigo);
    opacity: 0.85;
  }
  .rb-current .rb-bar {
    background: var(--rb-mint);
  }
  .rb-step-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rb-todo .rb-step-title {
    color: var(--rb-muted);
  }
  .rb-step-meta {
    color: var(--rb-muted);
    font-size: var(--sl-text-xs);
    margin-top: 0.15rem;
  }
  .rb-actor {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    border: 1px solid var(--rb-line);
    border-radius: 4px;
    padding: 0 0.3rem;
    margin-inline-end: 0.35rem;
  }
  .rb-actor-human {
    color: var(--rb-mint-text);
    border-color: var(--rb-mint);
  }
  .rb-verdict {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--rb-mint-text);
    border: 1px solid var(--rb-mint);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
    background: var(--rb-mint-subtle);
  }
  .rb-options {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  .rb-option {
    font-size: var(--sl-text-xs);
    border: 1px solid var(--rb-line);
    border-radius: 6px;
    padding: 0.2rem 0.7rem;
    color: var(--sl-color-gray-2);
  }
  .rb-option-primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
  }
  :global([data-theme='light']) .rb-option-primary {
    color: #ffffff;
  }

  @media (max-width: 50rem) {
    .rb-hero {
      grid-template-columns: 1fr;
    }
    .rb-run {
      max-width: 32rem;
    }
  }
</style>
