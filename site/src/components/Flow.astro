---
// A left-to-right flow of boxes (top to bottom on narrow screens), drawn in
// HTML so it follows the theme and reflows. `tone` colours a box like the
// web app: `agent` and `human` mark who does it, `current` is mint, `muted`
// is a step that may not happen. `loop` adds a note that the flow repeats.
interface Step {
  title: string;
  text?: string;
  tone?: 'agent' | 'human' | 'system' | 'current' | 'muted';
  tag?: string;
}
interface Props {
  steps: Step[];
  loop?: string;
  caption?: string;
}
const { steps, loop, caption } = Astro.props;
---

<figure class="rb-flow not-content">
  <ol style={`--rb-flow-count: ${steps.length}`}>
    {
      steps.map((s) => (
        <li class:list={['rb-flow-step', s.tone && `rb-tone-${s.tone}`]}>
          {s.tag && <span class="rb-flow-tag">{s.tag}</span>}
          <span class="rb-flow-title">{s.title}</span>
          {s.text && <span class="rb-flow-text">{s.text}</span>}
        </li>
      ))
    }
  </ol>
  {loop && <p class="rb-flow-loop"><span aria-hidden="true">↻</span> {loop}</p>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .rb-flow {
    margin: 1.75rem 0;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--rb-flow-count), minmax(0, 1fr));
    gap: 1.6rem;
  }
  .rb-flow-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0.8rem 0.9rem;
    background: var(--rb-card);
    border: 1px solid var(--rb-line);
    border-top: 3px solid var(--rb-line);
    border-radius: 10px;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }
  .rb-flow-step + .rb-flow-step::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -1.35rem;
    width: 1.1rem;
    height: 2px;
    background: var(--sl-color-gray-4);
  }
  .rb-flow-step + .rb-flow-step::after {
    content: '';
    position: absolute;
    top: calc(50% - 4px);
    left: -0.4rem;
    border: 5px solid transparent;
    border-left-color: var(--sl-color-gray-4);
    border-right: 0;
  }
  .rb-flow-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rb-flow-text {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  .rb-flow-tag {
    align-self: flex-start;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    color: var(--sl-color-gray-3);
    border: 1px solid var(--rb-line);
    border-radius: 4px;
    padding: 0 0.3rem;
  }
  .rb-tone-agent {
    border-top-color: var(--rb-indigo);
  }
  .rb-tone-human {
    border-top-color: #f59e0b;
  }
  .rb-tone-system {
    border-top-color: var(--sl-color-gray-3);
  }
  .rb-tone-current {
    border-top-color: var(--rb-mint);
    background: linear-gradient(var(--rb-mint-subtle), var(--rb-card) 70%);
  }
  .rb-tone-muted {
    border-style: dashed;
    border-top-style: solid;
  }
  .rb-tone-muted .rb-flow-title {
    color: var(--sl-color-gray-3);
  }
  .rb-flow-loop {
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .rb-flow-loop span {
    color: var(--rb-mint-text);
    font-weight: 700;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 45rem) {
    ol {
      grid-template-columns: 1fr;
      gap: 1.3rem;
    }
    .rb-flow-step + .rb-flow-step::before {
      top: -1.1rem;
      left: 1.25rem;
      width: 2px;
      height: 0.9rem;
    }
    .rb-flow-step + .rb-flow-step::after {
      top: -0.5rem;
      left: calc(1.25rem - 4px);
      border: 5px solid transparent;
      border-top-color: var(--sl-color-gray-4);
      border-bottom: 0;
    }
  }
</style>
