# Copy to deploy/.env (never commit it) and fill in the secrets:
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# Every value here is a placeholder. docker compose refuses to start while a
# required secret is missing.

# --- PostgreSQL (docker-compose.yml only) -----------------------------------
# The database administrator (a superuser): backups and maintenance only.
POSTGRES_USER=runbook
POSTGRES_DB=runbook
# Required.  openssl rand -hex 24
POSTGRES_PASSWORD=
# The unprivileged role the server connects as (no superuser, no createdb
# or createrole); it owns the `runbook` schema. Created on the volume's
# first start (deploy/postgres-init).
RUNBOOK_DB_USER=runbook_app
# Required. URL-safe characters only (it is placed inside DATABASE_URL):
#   openssl rand -hex 24
RUNBOOK_DB_PASSWORD=

# --- External database (docker-compose.external-db.yml only) ----------------
# PostgreSQL 14+; the server creates and migrates the `runbook` schema.
# sslmode has libpq's meaning (deploy/platforms.md, "Database URLs"):
# verify-full checks the certificate and host name; require only encrypts.
# DATABASE_URL=postgres://runbook:CHANGE_ME@db.example.internal:5432/runbook?sslmode=verify-full

# --- Server -----------------------------------------------------------------
# Required. Seals webhook subscription secrets at rest, and the runner's
# signing keys: 32 random bytes, base64. Generate once and keep it; losing
# it makes stored webhook secrets unreadable (rotate the subscriptions then)
# and replaces the signing keys.
#   openssl rand -base64 32
RUNBOOK_WEBHOOK_SECRET_KEY=

# The public URL users and the CLI reach the server at (scheme://host[:port],
# no path). Behind a TLS proxy this is the https:// URL. A plain http://
# origin on a non-loopback host makes `serve` print a warning at startup:
# bearer tokens would cross the network unencrypted.
RUNBOOK_ORIGIN=http://localhost:8080

# Host interface and port the server is published on. Loopback by default;
# set RUNBOOK_BIND_ADDRESS=0.0.0.0 only behind a firewall or TLS proxy.
RUNBOOK_BIND_ADDRESS=127.0.0.1
RUNBOOK_HOST_PORT=8080

# The reverse proxies whose X-Forwarded-For (or Forwarded) header names the
# client: a comma list of addresses or CIDR blocks; empty trusts none, and
# every client then shares the proxy's address in the per-IP sign-in limits.
# With a TLS proxy on this host in front of the loopback port, connections
# reach the container from the Docker bridge gateway, so trust the bridge
# (for example 172.16.0.0/12). Trust a proxy only when nothing else can reach
# the published port: a trusted peer may claim any client address.
RUNBOOK_TRUSTED_PROXIES=

# Webhook targets on private, loopback or plain-http addresses (self-hosted
# receivers on the same network). Link-local (cloud metadata) needs its own flag.
RUNBOOK_ALLOW_PRIVATE_WEBHOOK_TARGETS=false
RUNBOOK_ALLOW_LINK_LOCAL_WEBHOOK_TARGETS=false

# The runner (optional add-on): its URL may be a private, loopback or
# plain-http address (a runner on the same network). Link-local and cloud
# metadata addresses are always refused.
RUNBOOK_RUNNER_PRIVATE_NETWORKS=false
# A PEM file with the client certificate and key the server presents to
# the runner (mutual TLS), when the runner requires one.
# RUNBOOK_RUNNER_CLIENT_CERT=

# The web UI the image ships, served on RUNBOOK_ORIGIN (open it in a
# browser). On by default; uncomment to serve the API alone.
# RUNBOOK_WEB_DIR=

# --- Sign-in (D48) -----------------------------------------------------------
# People sign in with a one-time email code or with Google; there are no
# passwords. Sign-in is off until RUNBOOK_AUTH_SECRET is set; the server and
# the bootstrap token (seed-first-token.sh) still work without it.
# Required to enable any method: 32+ random characters.
#   openssl rand -hex 32
RUNBOOK_AUTH_SECRET=
# Which methods are on: email, google or both (comma list). Empty means
# every method configured below.
RUNBOOK_AUTH_METHODS=
# Email domains allowed to sign in (comma list, exact match); empty means any.
RUNBOOK_AUTH_ALLOWED_DOMAINS=
# Email codes: an SMTP relay, credentials in the URL (smtps:// for implicit
# TLS), and the From address. Both are needed for email codes.
#   RUNBOOK_SMTP_URL=smtps://login-user:CHANGE_ME@smtp.example.test:465
#   RUNBOOK_SMTP_FROM=The Runbook <login@example.test>
RUNBOOK_SMTP_URL=
RUNBOOK_SMTP_FROM=
# Google: an OAuth web client whose redirect URI is
# {RUNBOOK_ORIGIN}/api/auth/callback/google. Both or neither.
RUNBOOK_GOOGLE_CLIENT_ID=
RUNBOOK_GOOGLE_CLIENT_SECRET=

# --- Evidence uploads (D49–D51) ---------------------------------------------
# Photos, screenshots and files attached to steps. Off until both values are
# set. User files are served from a separate origin so a malicious file can
# never act as the app: use another domain than RUNBOOK_ORIGIN (ideally not a
# subdomain of it; never the same host name on another port, as cookies
# ignore ports), routed by your TLS proxy to RUNBOOK_USERCONTENT_HOST_PORT.
# Signing key for upload and file URLs: 32 random bytes, base64.
#   openssl rand -base64 32
RUNBOOK_UPLOAD_SIGNING_KEY=
#   RUNBOOK_USERCONTENT_ORIGIN=https://files.runbooks.example
RUNBOOK_USERCONTENT_ORIGIN=
# Host port of the user-content listener (published on RUNBOOK_BIND_ADDRESS).
RUNBOOK_USERCONTENT_HOST_PORT=8081

# --- Theme colours (UI-1) ---------------------------------------------------
# Override the web app's accent colours, each #rrggbb (either case; #rgb and
# colour names are refused). /v1/meta reports them as `theme`. The first two
# apply to both the light and the dark theme; a DARK value replaces its base
# value in the dark theme only. Empty means the app's own colours. A value
# that is not #rrggbb refuses startup (config.invalid_theme_color naming the
# variable); a colour below WCAG AA contrast (4.5:1 against #ffffff, or the
# dark background #14133a) only logs a warning at startup.
# RUNBOOK_THEME_ACCENT=#4338ca
# RUNBOOK_THEME_ACCENT_SECONDARY=#0e7490
# RUNBOOK_THEME_DARK_ACCENT=#a5b4fc
# RUNBOOK_THEME_DARK_ACCENT_SECONDARY=#67e8f9

# Memory caps (compose also caps each container at 200 processes).
# RUNBOOK_MEMORY_LIMIT=1g
# POSTGRES_MEMORY_LIMIT=1g

# --- Platform (deploy/platforms.md) ------------------------------------------
# These go in the server's `environment:` (compose) or the platform's settings.
# RUNBOOK_LOG_FORMAT=json             # one JSON object per log line on stdout
# RUNBOOK_DATABASE_POOL_SIZE=16       # server connections per instance
# RUNBOOK_AUTH_DATABASE_POOL_SIZE=5   # sign-in service connections per instance
# RUNBOOK_SHUTDOWN_TIMEOUT_SECS=8     # longest stop after SIGTERM

# Image tag compose builds and runs.
RUNBOOK_IMAGE=runbook-pilot:local
