{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/test-utils/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "vitest.global-setup.ts"
  ]
}
