{
  "name": "runbook-auth",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "The Runbook sign-in service: Better Auth (email codes and Google) on D1 (worker.ts) and Postgres (server.ts).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.worker.json && tsc -p tsconfig.server.json",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "nodemailer": "10.2.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "7.0.2"
  }
}
